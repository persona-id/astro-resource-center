---
import pages from "../data/pages.json";
import PageRenderer from "../components/PageRenderer.astro";
import ResourceLayout from "../layouts/ResourceLayout.astro";
import type { ResourcePage } from "../types/resource-center";

export function getStaticPaths() {
  return (pages as ResourcePage[])
    .filter((page) => page.path !== "/" && page.path !== "/404/")
    .map((page) => ({
      params: { path: page.path.replace(/^\//, "").replace(/\/$/, "") },
      props: { page },
    }));
}

const { page } = Astro.props as { page: ResourcePage };
const entity =
  page.context.contentfulHelpCenterArticle ??
  page.context.contentfulEnterpriseEndUserArticle ??
  page.context.contentfulAcademyLesson ??
  page.context.contentfulPodcastEpisode ??
  page.context.contentfulCommunityEvent ??
  page.context.contentfulCategory ??
  page.context.contentfulTopic ??
  page.context.contentfulSubtopic;
const title = entity?.title ?? (page.kind === "articles" ? "Articles" : page.kind === "academy" ? "Persona Academy" : page.kind === "community" ? "Persona Community" : "Persona Help Center");
const description = entity?.description?.childMarkdownRemark?.rawMarkdownBody ?? entity?.seoDescription?.childMarkdownRemark?.rawMarkdownBody ?? (typeof entity?.description === "string" ? entity.description : undefined);
const hideChrome = page.kind === "endUserArticle";
---
<ResourceLayout title={title} description={description} path={page.path} hideChrome={hideChrome} page={page}><PageRenderer page={page} /></ResourceLayout>
