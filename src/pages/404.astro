---
import pages from "../data/pages.json";
import PageRenderer from "../components/PageRenderer.astro";
import ResourceLayout from "../layouts/ResourceLayout.astro";
import type { ResourcePage } from "../types/resource-center";
const page = (pages as ResourcePage[]).find((entry) => entry.kind === "notFound")!;
Astro.response.status = 404;
---
<ResourceLayout title="Page not found" path="/404/"><PageRenderer page={page} /></ResourceLayout>
