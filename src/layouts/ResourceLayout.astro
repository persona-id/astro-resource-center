---
import "../styles/global.css";
import personaLogo from "../assets/persona-logo.svg";
import navigation from "../data/navigation.json";
import NavigationTree from "../components/NavigationTree.astro";
import type { ResourcePage } from "../types/resource-center";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  hideChrome?: boolean;
  page?: ResourcePage;
}

const {
  title = "Persona Help Center",
  description = "Resources, articles, checklists, key concepts, and tutorials to help you learn, explore, and integrate Persona.",
  path = "/",
  hideChrome = false,
  page,
} = Astro.props;
const fullTitle = title === "Persona Help Center" ? title : `${title} | Persona Help Center`;
const dashboardUrl = import.meta.env.PUBLIC_PERSONA_HOSTNAME ?? import.meta.env.PERSONA_HOSTNAME ?? "https://app.withpersona.com";
const article = page?.context.contentfulHelpCenterArticle;
const articleSubtopic = article?.subtopic?.[0];
const articleTopic = articleSubtopic?.topic?.[0];
const articleCategory = articleTopic?.category?.[0];
const currentCategory = page?.context.contentfulCategory ?? articleCategory;
const currentTopic = page?.context.contentfulTopic ?? articleTopic;
const currentSubtopic = page?.context.contentfulSubtopic ?? articleSubtopic;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>
  </head>
  <body data-path={path}>
    {!hideChrome && (
      <header class="topbar">
        <a class="brand" href="/">
          <img src={personaLogo.src} alt="Persona logo" />
          <span>Persona Help Center</span>
        </a>
        <nav class="topnav" aria-label="Main navigation">
          <a href="/articles">Articles</a>
          <a href="/community">Community</a>
          <a href="https://academy.withpersona.com" target="_blank">Academy</a>
          <a href="https://docs.withpersona.com/docs" target="_blank">Developer Docs</a>
          <a href="https://status.withpersona.com/" target="_blank">System Status</a>
          <button class="icon-button" id="open-search" aria-label="Search">
            <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.75" /><path d="m10.5 10.5 3 3" /></svg>
          </button>
        </nav>
        <div class="top-actions">
          <a class="button" href={`${dashboardUrl}/dashboard`} target="_blank">Go to Dashboard</a>
          <button class="icon-button mobile-search" id="open-search-mobile" aria-label="Search"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.75" /><path d="m10.5 10.5 3 3" /></svg></button>
          <button class="icon-button mobile-menu" id="open-menu" aria-label="Open menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" /></svg></button>
        </div>
      </header>
    )}
    <div class:list={["site-shell", hideChrome && "site-shell--plain"]}>
      {!hideChrome && (
        <aside class="sidebar" id="sidebar">
          <section class="sidebar-card">
            <h2>Articles</h2>
            <NavigationTree
              categories={navigation}
              currentCategoryId={currentCategory?.id}
              currentTopicId={currentTopic?.id}
              currentSubtopicId={currentSubtopic?.id}
            />
          </section>
          <section class="sidebar-card">
            <h2>Get help now</h2>
            <a class="support-link" href={`${dashboardUrl}/dashboard/contact-us`} target="_blank">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.25 3.25h11.5v8H6.5L3 13.75v-2.5h-.75z" /></svg>
              <span>Submit a request</span>
            </a>
          </section>
        </aside>
      )}
      <main class="page-content"><slot /></main>
    </div>

    <dialog id="search-dialog" class="search-dialog">
      <form method="dialog"><button class="dialog-close" aria-label="Close search">×</button></form>
      <label for="site-search">Search the Help Center</label>
      <input id="site-search" type="search" placeholder="Search articles, courses, and events…" autocomplete="off" />
      <div id="search-results" class="search-results" aria-live="polite"></div>
    </dialog>

    <script>
      const dialog = document.querySelector<HTMLDialogElement>("#search-dialog");
      const input = document.querySelector<HTMLInputElement>("#site-search");
      const results = document.querySelector<HTMLElement>("#search-results");
      let index: Array<{ path: string; title: string; description: string; kind: string }> = [];

      async function openSearch() {
        dialog?.showModal();
        input?.focus();
        if (!index.length) index = await fetch("/search-index.json").then((response) => response.json());
      }

      document.querySelector("#open-search")?.addEventListener("click", openSearch);
      document.querySelector("#open-search-mobile")?.addEventListener("click", openSearch);
      document.addEventListener("keydown", (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
          event.preventDefault();
          openSearch();
        }
      });
      document.querySelector("#open-menu")?.addEventListener("click", () => {
        document.querySelector("#sidebar")?.classList.toggle("sidebar--open");
      });
      input?.addEventListener("input", () => {
        const query = input.value.trim().toLowerCase();
        if (!results) return;
        if (query.length < 2) {
          results.innerHTML = "";
          return;
        }
        const matches = index
          .filter((item) => `${item.title} ${item.description}`.toLowerCase().includes(query))
          .slice(0, 8);
        results.innerHTML = matches.length
          ? matches.map((item) => `<a href="${item.path}"><strong>${item.title}</strong><span>${item.description || item.kind}</span></a>`).join("")
          : "<p>No results found.</p>";
      });
    </script>
  </body>
</html>
